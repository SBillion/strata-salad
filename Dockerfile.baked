# syntax=docker/dockerfile:1
#
# Strata "baked" image — engine image + model already downloaded AND prepared
# (pack + MTP) inside the image. On SaladCloud the container disk is ephemeral,
# so without this the ~68 GB model is re-downloaded and re-packed on every new
# instance. Baking it in makes the first start only load the model and serve.
#
# Build the base engine image first with upstream's own Dockerfile (which
# compiles the engine), then this one:
#
#   docker build -t strata-base \
#     --build-arg CUDA_ARCHITECTURES=86 \
#     -f <strata-src>/Dockerfile <strata-src>
#
#   docker build -t strata-baked \
#     --build-arg BASE_IMAGE=strata-base \
#     --build-arg STRATA_MODEL=IQ2_XS \
#     --build-arg STRATA_CONTEXT=32768 \
#     -f Dockerfile.baked .
#
# salad.sh does both steps for you (`SALAD_BAKE=1 salad.sh build`).
#
# Build args:
#   STRATA_KEEP_GGUF=1  (default) keep the raw model files -> biggest image.
#   STRATA_KEEP_GGUF=0  drop them: with LOW_RAM=on the engine reads the experts
#                       from the prepared pack, so the raw GGUF (most of the
#                       image) can be removed. Saves ~68 GB. EXPERIMENTAL:
#                       verify the server starts before relying on it.
#
# WARNING: the model ends up in a single image layer of tens of GB. Registries
# with a per-layer limit (Docker Hub, GHCR ~10 GB) may reject the push. Use a
# registry that allows large layers (self-hosted registry:2, AWS ECR, Azure
# ACR, Artifact Registry) or pick a small model. See README.

ARG BASE_IMAGE=strata-base

# ---------------------------------------------------------------------------
# Stage 1: download + prepare the model (setup.py --setup --no-start)
# ---------------------------------------------------------------------------
FROM ${BASE_IMAGE} AS prep

ARG STRATA_FAMILY=qwen
ARG STRATA_MODEL=IQ2_XS
ARG STRATA_CONTEXT=32768
ARG STRATA_VISION=no
ARG STRATA_LOW_RAM=on
ARG STRATA_KV=""

# Bake into a dedicated dir (not /data, which the base image declares as a
# volume) and point Strata at it.
ENV STRATA_DATA=/opt/strata-data

RUN mkdir -p "$STRATA_DATA" && \
    .venv/bin/python setup.py --setup --yes \
        --family "$STRATA_FAMILY" \
        --model "$STRATA_MODEL" \
        --context "$STRATA_CONTEXT" \
        --vision "$STRATA_VISION" \
        --low-ram "$STRATA_LOW_RAM" \
        ${STRATA_KV:+--kv "$STRATA_KV"} \
        --data-dir "$STRATA_DATA" \
        --no-start

# ---------------------------------------------------------------------------
# Stage 2: optionally drop the raw GGUF. Removing files in a *separate* stage
# (then COPYing the result) really shrinks the final image, unlike `rm` in the
# same RUN as the download.
# ---------------------------------------------------------------------------
FROM prep AS trimmed

ARG STRATA_LOW_RAM=on
ARG STRATA_KEEP_GGUF=1

RUN if [ "$STRATA_KEEP_GGUF" != "1" ]; then \
      if [ "$STRATA_LOW_RAM" != "on" ]; then \
        echo "WARNING: STRATA_KEEP_GGUF=0 with LOW_RAM!='on': the engine may need the raw GGUF"; \
      fi; \
      echo "dropping raw model files under $STRATA_DATA/models (experts come from the pack)"; \
      rm -rf "$STRATA_DATA/models"; \
    fi && \
    du -sh "$STRATA_DATA"

# ---------------------------------------------------------------------------
# Stage 3: final image = base engine + prepared data + socat (IPv6 relay)
# ---------------------------------------------------------------------------
FROM ${BASE_IMAGE}

ENV STRATA_DATA=/opt/strata-data

# socat: SaladCloud's gateway/probes speak IPv6; Strata listens on IPv4 only.
# Baking it in avoids an apt-get at every container start.
RUN apt-get update && \
    apt-get install -y --no-install-recommends socat && \
    rm -rf /var/lib/apt/lists/*

COPY --from=trimmed /opt/strata-data /opt/strata-data
